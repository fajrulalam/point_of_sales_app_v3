rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // BEGIN GLOBAL COMPETITION POLICY
    function validCompetitionMetadata() {
      let data = request.resource.data;
      return (!data.keys().hasAny(["rankingMode"]) || data.rankingMode in ["category", "global"]) &&
        (!data.keys().hasAny(["winnerCount"]) || (data.winnerCount is int && data.winnerCount >= 0));
    }

    function validCompetitionPrize(periodId) {
      let data = request.resource.data;
      return validCompetitionMetadata() && (periodId < "2026-09" ||
        (data.rankingMode == "global" && data.winnerCount == 3 &&
          data.winners is list && data.winners.size() <= 3 &&
          data.configuration.amountsByRank == {"1": 50000, "2": 25000, "3": 15000}));
    }

    function validCompetitionWinner(periodId, winnerId) {
      let data = request.resource.data;
      return validCompetitionMetadata() && (periodId < "2026-09" ||
        (data.rankingMode == "global" && data.rank in [1, 2, 3] &&
          ((data.rank == 1 && winnerId == "rank_1" && data.prizeAmount == 50000) ||
           (data.rank == 2 && winnerId == "rank_2" && data.prizeAmount == 25000) ||
           (data.rank == 3 && winnerId == "rank_3" && data.prizeAmount == 15000))));
    }

    function validCompetitionVoucherCreate() {
      let data = request.resource.data;
      return data.get("type", "") != "competitionPrize" ||
        data.get("competitionPrizePeriod", "") < "2026-09" ||
        (data.rankingMode == "global" && data.competitionRank in [1, 2, 3] &&
          data.value == {"1": 50000, "2": 25000, "3": 15000}[
            data.competitionRank == 1 ? "1" : (data.competitionRank == 2 ? "2" : "3")]);
    }
    // END GLOBAL COMPETITION POLICY

    function isAuthenticated() { return request.auth != null; }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "gnavsih1@gmail.com" ||
        request.auth.token.email == "admin@canteen375.com" ||
        request.auth.token.email == "siti@canteen375.com" ||
        request.auth.token.email == "amalia@canteen375.com" ||
        request.auth.token.email == "eka@canteen375.com" ||
        request.auth.token.email == "widya@canteen375.com"
      );
    }

    function validVoucherProgramCounters() {
      return request.resource.data.status in ["active", "paid", "closed"] &&
        request.resource.data.totalRedeemed is int &&
        request.resource.data.totalRedeemed >= 0 &&
        request.resource.data.totalSettled is int &&
        request.resource.data.totalSettled >= 0 &&
        request.resource.data.totalSettled <= request.resource.data.totalRedeemed;
    }

    function validVoucherProgramFields() {
      return request.resource.data.programName is string &&
        request.resource.data.programName.size() > 0 &&
        request.resource.data.institutionName is string &&
        request.resource.data.institutionName.size() > 0 &&
        request.resource.data.defaultNominal is int &&
        request.resource.data.defaultNominal >= 0 &&
        request.resource.data.revision is int &&
        request.resource.data.revision >= 0;
    }

    function validVoucherProgramCreate() {
      return validVoucherProgramCounters() &&
        request.resource.data.status == "active" &&
        validVoucherProgramFields();
    }

    function isMemberProfileOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    function memberIdRefersToAuthUser(memberDocId) {
      return memberDocId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Members/$(memberDocId)) &&
          get(/databases/$(database)/documents/Members/$(memberDocId)).data.uid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/zTesting_Members/$(memberDocId)) &&
          get(/databases/$(database)/documents/zTesting_Members/$(memberDocId)).data.uid == request.auth.uid);
    }

    function memberProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "fullName", "name", "nama", "phoneNumber", "phone", "email",
        "photoUrl", "address", "updatedAt"
      ]);
    }

    function validMemberPointLedger() {
      return request.resource.data.operationId is string &&
        request.resource.data.operationId.size() > 0 &&
        request.resource.data.eventType in ["earn", "reverse", "manual_adjustment"] &&
        request.resource.data.status in ["completed", "pending"] &&
        request.resource.data.pointsDelta is int &&
        request.resource.data.memberId is string &&
        request.resource.data.memberId.size() > 0;
    }

    function validMemberProgramOperation() {
      return request.resource.data.operationId is string &&
        request.resource.data.operationId.size() > 0 &&
        request.resource.data.status in ["completed", "pending", "skipped"];
    }

    function validMemberCampaign() {
      return request.resource.data.type == "cashbackCampaign" &&
        request.resource.data.status in ["active", "archived"] &&
        request.resource.data.isActive is bool &&
        ((request.resource.data.status == "active" && request.resource.data.isActive == true) ||
          (request.resource.data.status == "archived" && request.resource.data.isActive == false)) &&
        request.resource.data.threshold is int &&
        request.resource.data.threshold > 0 &&
        request.resource.data.value is int &&
        request.resource.data.value > 0 &&
        request.resource.data.transactionRequirement is int &&
        request.resource.data.transactionRequirement >= 0 &&
        request.resource.data.activeDate is timestamp &&
        request.resource.data.expireDate is timestamp &&
        request.resource.data.expireDate >= request.resource.data.activeDate &&
        request.resource.data.totalParticipants is int &&
        request.resource.data.totalParticipants >= 0 &&
        request.resource.data.totalClaimed is int &&
        request.resource.data.totalClaimed >= 0 &&
        request.resource.data.totalClaimed <= request.resource.data.totalParticipants &&
        request.resource.data.totalRedemptions is int &&
        request.resource.data.totalRedemptions >= request.resource.data.totalClaimed;
    }

    match /Categories/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /assets/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /config/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /DailyTransaction/{id} { allow read, write: if isAuthenticated(); }
    match /MonthlyTransaction/{id} { allow read, write: if isAuthenticated(); }
    match /YearlyTransaction/{id} { allow read, write: if isAuthenticated(); }
    match /DailyFinancialReport/{id} {
      allow read, write, update, delete: if true;
      match /Expenses/{expenseId} { allow read, write, update, delete: if true; }
    }
    match /MonthlyFinancialReport/{id} { allow read, write, update, delete: if true; }
    match /YearlyFinancialReport/{id} { allow read, write, update, delete: if true; }
    match /Status/{id} { allow read, write, delete, update: if true; }
    match /Expenses/{id} { allow read, write: if isAuthenticated(); }
    match /CashflowSettings/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /RecentlyServed/{id} { allow read, write, delete, update: if true; }

    match /MemberLinks/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;
      allow create: if isAuthenticated() && request.auth.uid == authUid
                    && request.resource.data.memberDocId is string
                    && request.resource.data.memberDocId.size() > 0;
      allow update, delete: if isAdmin();
    }
    match /Members/{memberDocId} {
      allow get: if !exists(/databases/$(database)/documents/Members/$(memberDocId)) || isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == "member";
      allow update: if isAdmin() ||
        (isMemberProfileOwner() && memberProfileFieldsOnly());
      allow delete: if isAdmin();
    }

    match /voucher/{id} {
      allow read: if isAdmin() || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow write: if isAdmin();
    }
    match /vouchers/{id} {
      allow read: if isAdmin() || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow create: if isAdmin() && validCompetitionVoucherCreate();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // B2B programs, counters, and operation ledgers are POS-admin mutations.
    // Cashier accounts must therefore be members of isAdmin(), even though
    // other operational collections retain their existing POS permissions.
    match /voucherPrograms/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && validVoucherProgramCreate();
      allow update: if isAdmin() && resource.data.status != "closed" &&
        validVoucherProgramCounters() && validVoucherProgramFields();
      allow delete: if isAdmin() && resource.data.status != "closed";
      match /redemptions/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          ((request.resource.data.eventType == "redemption" &&
              request.resource.data.amount is int &&
              request.resource.data.amount > 0) ||
            (request.resource.data.eventType == "edit" &&
              request.resource.data.amountDelta is int &&
              request.resource.data.amountDelta != 0));
        allow delete: if false;
      }
      match /settlements/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.paymentMethod in ["Cash", "QRIS", "Online"];
        allow delete: if false;
      }
      match /closures/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed";
        allow delete: if false;
      }
    }
    match /voucherGroup/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.voucherGroupId == groupId &&
        validMemberCampaign();
      allow update: if isAdmin() && request.resource.data.voucherGroupId == groupId &&
        validMemberCampaign() &&
        (resource.data.status != "archived" ||
          request.resource.data.status == "archived");
      allow delete: if false;
    }
    match /competitionRecords/{monthId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCompetitionMetadata();
      allow delete: if false;
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }
    match /SelfOrders/{orderId} { allow read, write: if true; }
    match /pointTransactions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow create: if isAdmin() &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow update: if isAdmin() &&
        resource.data.operationId == id &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow delete: if false;
    }
    match /memberProgramOperations/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.operationId == id &&
        validMemberProgramOperation();
      allow delete: if false;
    }
    match /competitionPrizes/{periodId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCompetitionPrize(periodId);
      allow delete: if false;
      match /winners/{winnerId} {
        allow read: if true;
        allow create, update: if isAdmin() && validCompetitionWinner(periodId, winnerId);
        allow delete: if false;
      }
    }
    match /externalVoucherClaims/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.operationId == id &&
        request.resource.data.status in ["pending", "failed", "completed"];
      allow delete: if false;
    }
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated() && memberIdRefersToAuthUser(request.resource.data.memberId);
      allow read: if isAdmin() || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow update, delete: if isAdmin();
    }

    match /Canteens/{canteenId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
      match /Inventory/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /DailyStockLogs/{id} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /MenuCollection/{menuId} { allow read: if true; allow write: if isAdmin(); }
      match /Metadata/{configId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isAuthenticated() && configId == 'SelfOrderCounter');
      }
      match /Metadata/Settings { allow read: if isAuthenticated(); }
      match /OptionGroups/{groupId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /suppliers/{supplierId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /shoppingOrders/{orderId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      // Deliveries received from Sentra Distribusi Rejoso Gemilang, and the
      // map from their product IDs to our inventory items. This block lists
      // every subcollection explicitly, so new ones must be added here or they
      // are denied in production while still working under zTesting_Canteens.
      match /SdrgProductLinks/{sdrgProductId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /SdrgDeliveries/{sdrgOrderId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
      match /Status/{orderId} { allow read, write, update, delete: if true; }
      match /RecentlyServed/{orderId} { allow read, write, update, delete: if true; }
      match /SelfOrders/{orderId} {
        allow read: if isAdmin() || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
        allow create: if isAuthenticated() && memberIdRefersToAuthUser(request.resource.data.memberId);
        allow update, delete: if isAdmin();
      }
      match /OpenBills/{memberId} {
        allow read, write, update, delete: if isAdmin();
        match /Orders/{tabOrderId} { allow read, write, update, delete: if isAdmin(); }
      }
      match /OpenBillLocks/{memberId} { allow read, write, update, delete: if isAdmin(); }
      match /SettledBills/{billId} { allow read, write, update, delete: if isAdmin(); }
      match /Orders/{orderID} { allow read, write, update, delete: if isAdmin(); }
    }

    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }
    match /products_test/{productId} { allow read: if true; allow write: if isAdmin(); }

    // Testing-mode data is intentionally open only in the local/test project.
    // B2B program and ledger writes remain admin-only so a misconfigured test
    // client cannot exercise an unauthorised mutation against a shared project.
    match /zTesting_Categories/{id} { allow read, write, update, delete: if true; }
    match /zTesting_DailyTransaction/{id} { allow read, write, update, delete: if true; }
    match /zTesting_MonthlyTransaction/{id} { allow read, write, update, delete: if true; }
    match /zTesting_YearlyTransaction/{id} { allow read, write, update, delete: if true; }
    match /zTesting_DailyFinancialReport/{id} {
      allow read, write, update, delete: if true;
      match /Expenses/{expenseId} { allow read, write, update, delete: if true; }
    }
    match /zTesting_MonthlyFinancialReport/{id} { allow read, write, update, delete: if true; }
    match /zTesting_YearlyFinancialReport/{id} { allow read, write, update, delete: if true; }
    match /zTesting_Expenses/{id} { allow read, write: if true; }
    match /zTesting_Status/{id} { allow read, write, update, delete: if true; }
    match /zTesting_RecentlyServed/{id} { allow read, write, delete, update: if true; }
    match /zTesting_Members/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid && memberProfileFieldsOnly());
      allow delete: if isAdmin();
    }
    match /zTesting_CashflowSettings/{id} { allow read, write, update, delete: if true; }
    match /zTesting_competitionRecords/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validCompetitionMetadata();
      allow delete: if false;
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }
    match /zTesting_voucher/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow write: if isAdmin();
    }
    match /zTesting_vouchers/{id} {
      allow read: if isAdmin() || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow create: if isAdmin() && validCompetitionVoucherCreate();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /zTesting_voucherGroup/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.voucherGroupId == id &&
        validMemberCampaign();
      allow update: if isAdmin() && request.resource.data.voucherGroupId == id &&
        validMemberCampaign() &&
        (resource.data.status != "archived" ||
          request.resource.data.status == "archived");
      allow delete: if false;
    }
    match /zTesting_voucherPrograms/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && validVoucherProgramCreate();
      allow update: if isAdmin() && resource.data.status != "closed" &&
        validVoucherProgramCounters() && validVoucherProgramFields();
      allow delete: if isAdmin() && resource.data.status != "closed";
      match /redemptions/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          ((request.resource.data.eventType == "redemption" &&
              request.resource.data.amount is int &&
              request.resource.data.amount > 0) ||
            (request.resource.data.eventType == "edit" &&
              request.resource.data.amountDelta is int &&
              request.resource.data.amountDelta != 0));
        allow delete: if false;
      }
      match /settlements/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          request.resource.data.amount is int &&
          request.resource.data.amount > 0 &&
          request.resource.data.paymentMethod in ["Cash", "QRIS", "Online"];
        allow delete: if false;
      }
      match /closures/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed";
        allow delete: if false;
      }
    }
    match /zTesting_MemberLinks/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;
      allow create: if isAuthenticated() && request.auth.uid == authUid
                    && request.resource.data.memberDocId is string
                    && request.resource.data.memberDocId.size() > 0;
      allow update, delete: if isAdmin();
    }
    match /zTesting_Canteens/{canteenId} {
      allow read, write, update, delete: if true;
      match /{subcollection=**} { allow read, write, update, delete: if true; }
    }
    match /zTesting_pointTransactions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow create: if isAdmin() &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow update: if isAdmin() &&
        resource.data.operationId == id &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow delete: if false;
    }
    match /zTesting_memberProgramOperations/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.operationId == id && validMemberProgramOperation();
      allow delete: if false;
    }
    match /zTesting_competitionPrizes/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validCompetitionPrize(id);
      allow delete: if false;
      match /winners/{winnerId} {
        allow read: if true;
        allow create, update: if isAdmin() && validCompetitionWinner(id, winnerId);
        allow delete: if false;
      }
    }
    match /zTesting_externalVoucherClaims/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.operationId == id &&
        request.resource.data.status in ["pending", "failed", "completed"];
      allow delete: if false;
    }
    match /zTesting_SelfOrders/{id} { allow read, write, update, delete: if true; }
    match /zTesting_feedbacks/{id} { allow read, write, update, delete: if true; }
    match /zTesting_assets/{id} { allow read, write, update, delete: if true; }
    match /zTesting_config/{id} { allow read, write, update, delete: if true; }
  }
}
